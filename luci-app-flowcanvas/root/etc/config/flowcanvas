config flowcanvas 'main'
	option enabled '0'
	option api_port '16789'
	option database '/var/lib/flowcanvas/flowcanvas.db'
	option mihomo_controller 'http://127.0.0.1:9090'
	option mihomo_secret ''
	option mihomo_config '/etc/mihomo/config.yaml'
	option mihomo_backup_dir '/etc/mihomo/.flowcanvas-backups'
	option connection_interval '250ms'
	option compilation_timeout '15s'
	option feature_queue_capacity '8192'
	option feature_batch_size '256'
	option feature_flush_interval '200ms'
	option topology_interval '30s'
	option proxy_refresh_interval '10s'
