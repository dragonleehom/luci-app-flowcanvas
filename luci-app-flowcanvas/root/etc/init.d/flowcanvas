#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

NAME="flowcanvasd"
PROG="/usr/libexec/flowcanvasd"

start_service() {
	config_load flowcanvas
	local enabled
	config_get_bool enabled main enabled 0
	if [ "$enabled" -eq 0 ]; then
		return 0
	fi

	local api_port database mihomo_controller mihomo_secret mihomo_config mihomo_backup_dir
	local connection_interval compilation_timeout feature_queue_capacity feature_batch_size feature_flush_interval
	local topology_interval proxy_refresh_interval

	config_get api_port main api_port "16789"
	case "$api_port" in
		*[!0-9]*|'')
			echo "flowcanvas: api_port must be a numeric TCP port" >&2
			return 1
			;;
	esac
	if [ "$api_port" -lt 1024 ] || [ "$api_port" -gt 65535 ]; then
		echo "flowcanvas: api_port must be between 1024 and 65535" >&2
		return 1
	fi
	config_get database main database "/var/lib/flowcanvas/flowcanvas.db"
	config_get mihomo_controller main mihomo_controller "http://127.0.0.1:9090"
	config_get mihomo_secret main mihomo_secret ""
	config_get mihomo_config main mihomo_config "/etc/mihomo/config.yaml"
	config_get mihomo_backup_dir main mihomo_backup_dir "/etc/mihomo/.flowcanvas-backups"

	config_get connection_interval main connection_interval "250ms"
	config_get compilation_timeout main compilation_timeout "15s"
	config_get feature_queue_capacity main feature_queue_capacity "8192"
	config_get feature_batch_size main feature_batch_size "256"
	config_get feature_flush_interval main feature_flush_interval "200ms"
	config_get topology_interval main topology_interval "30s"
	config_get proxy_refresh_interval main proxy_refresh_interval "10s"

	mkdir -p "$(dirname "$database")" "$mihomo_backup_dir"
	chmod 0750 "$(dirname "$database")" "$mihomo_backup_dir"

	if ! /usr/libexec/flowcanvas/check-environment --quiet; then
		echo "flowcanvas: startup aborted by environment checks" >&2
		return 1
	fi

	procd_open_instance
		procd_set_param command "$PROG"

	procd_set_param env FLOWCANVAS_LISTEN="127.0.0.1:$api_port"
	procd_set_param env FLOWCANVAS_DB="$database"
	procd_set_param env FLOWCANVAS_MIHOMO_CONTROLLER="$mihomo_controller"
	procd_set_param env FLOWCANVAS_MIHOMO_SECRET="$mihomo_secret"
	procd_set_param env FLOWCANVAS_MIHOMO_CONFIG="$mihomo_config"
	procd_set_param env FLOWCANVAS_MIHOMO_BACKUP_DIR="$mihomo_backup_dir"
	procd_set_param env FLOWCANVAS_CONNECTION_INTERVAL="$connection_interval"
	procd_set_param env FLOWCANVAS_COMPILATION_TIMEOUT="$compilation_timeout"
	procd_set_param env FLOWCANVAS_FEATURE_QUEUE_CAPACITY="$feature_queue_capacity"
	procd_set_param env FLOWCANVAS_FEATURE_BATCH_SIZE="$feature_batch_size"
	procd_set_param env FLOWCANVAS_FEATURE_FLUSH_INTERVAL="$feature_flush_interval"
	procd_set_param env FLOWCANVAS_TOPOLOGY_INTERVAL="$topology_interval"
	procd_set_param env FLOWCANVAS_PROXY_REFRESH_INTERVAL="$proxy_refresh_interval"
	procd_set_param env FLOWCANVAS_DEMO="false"

	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn "${respawn_threshold:-3600}" "${respawn_timeout:-5}" "${respawn_retry:-5}"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "flowcanvas"
}
